{
  "routes": [
    {
      "src": "^/password$",
      "dest": "/password.html"
    },
    {
      "src": "/(.*)\\.(css|js|png|jpg|jpeg|svg|gif|webp)$",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)\\.html",
      "dest": "/api/middleware.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/middleware.js"
    }
  ]
}
