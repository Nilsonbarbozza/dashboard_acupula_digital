{
  "routes": [
    {
      "src": "^/password$",
      "dest": "/password.html"
    },
    {
      "src": "/(.*)\\.(css|js|png|jpg|jpeg|svg|gif|webp)$",
      "dest": "/$1.$2"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
